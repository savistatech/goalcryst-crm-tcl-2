# ==============================================================================
# GoalCryst CRM TCL-2 — Production Environment Template
# Target location on VPS: /apps/tcl-2/.env.production (Permissions: chmod 600)
# Frontend Domain: https://tcl.goalcryst.co.in
# Backend API Domain: https://tcl-api.goalcryst.co.in
# DO NOT commit real production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC BROWSER & BUILD-TIME VARIABLES
# Used by client-side browser bundle and inlined during `next build`.
# ------------------------------------------------------------------------------
# External HTTPS URL of the dedicated TCL-2 Supabase Kong API Gateway
NEXT_PUBLIC_SUPABASE_URL=https://tcl-api.goalcryst.co.in

# Public anonymous JWT key matching TCL-2 Supabase project's JWT secret
NEXT_PUBLIC_SUPABASE_ANON_KEY=<REPLACE_WITH_TCL2_PRODUCTION_ANON_KEY>

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY RUNTIME VARIABLES (NEVER EXPOSE AS NEXT_PUBLIC_*)
# Used exclusively by Next.js Server Actions, Proxy, and SSR routes.
# ------------------------------------------------------------------------------
# Internal Docker DNS URL to TCL-2 Supabase Kong on `supabase-tcl2_default` network
SUPABASE_INTERNAL_URL=http://supabase-tcl2-kong:8000

# Service-role secret key for TCL-2 administrative actions (user provisioning, password reset)
SUPABASE_SERVICE_ROLE_KEY=<REPLACE_WITH_TCL2_PRODUCTION_SERVICE_ROLE_KEY>
